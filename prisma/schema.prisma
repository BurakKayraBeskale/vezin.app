generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Role: "ADMIN" | "EMPLOYEE"
// User Status: "ACTIVE" | "INACTIVE" | "DELETED"
// Task Status: "TODO" | "IN_PROGRESS" | "REVIEW" | "DONE"
// Priority: "LOW" | "MEDIUM" | "HIGH"
// Department (user): "OUTSOURCE" | "BAGIMSIZ_DENETIM" | "MUHASEBE" | "YEMINLI_MALI_MUSAVIR" | "ADMIN"
// Project department: "OUTSOURCE" | "BAGIMSIZ_DENETIM" | "MUHASEBE" | "YMM"

model User {
  id                    String              @id @default(cuid())
  name                  String
  email                 String              @unique
  password              String
  role                  String              @default("EMPLOYEE")
  department            String              @default("OUTSOURCE")
  mustChangePassword    Boolean             @default(true)
  title                 String              @default("")
  seniorityLevel        Int                 @default(0)
  canViewAllTasks       Boolean             @default(false)
  canViewAllProjects    Boolean             @default(false)
  overseesDepartment    String? // "BAGIMSIZ_DENETIM" | "VERGI" | null
  canManageCompanies    Boolean             @default(false)
  canBeAssignedTasks    Boolean             @default(true)
  showInPerformance     Boolean             @default(true)
  canAccessRotasyon     Boolean             @default(false)
  status                String              @default("ACTIVE")
  createdAt             DateTime            @default(now())
  assignedTasks         Task[]              @relation("AssignedTo")
  createdTasks          Task[]              @relation("CreatedBy")
  taskAssignees         TaskAssignee[]
  feedbacks             Feedback[]
  files                 File[]
  taskLogs              TaskLog[]
  petitions             Petition[]
  leaveRequests         LeaveRequest[]      @relation("LeaveRequests")
  leaveBalances         LeaveBalance[]      @relation("LeaveBalances")
  manages               UserRelation[]      @relation("manages")
  subordinateTo         UserRelation[]      @relation("subordinateTo")
  notifications         Notification[]
  meetingsCreated       Meeting[]           @relation("MeetingCreator")
  meetingAttendees      MeetingAttendee[]
  templates             TaskTemplate[]      @relation("TemplateCreator")
  taskComments          TaskComment[]
  loginLogs             LoginLog[]
  companyAssignments    CompanyAssignment[]
  projectMembers        ProjectMember[]
  projectsCreated       Project[]           @relation("ProjectCreatedBy")
  karsitIncelemeler     KarsitInceleme[]
  reviewRoundsSubmitted TaskReviewRound[]   @relation("ReviewRoundSubmitter")
  reviewRoundsReviewed  TaskReviewRound[]   @relation("ReviewRoundReviewer")
  taskSources           TaskSource[]
  taskAttachments       TaskAttachment[]
  ownedSeries           RecurringSeries[]   @relation("SeriesOwner")
  assignedSeries        RecurringSeries[]   @relation("SeriesAssignee")
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String // TASK_ASSIGNED | LEAVE_APPROVED | LEAVE_REJECTED | FEEDBACK_RECEIVED | MENTIONED | COMMENTED | COMPANY_5_YEARS
  message   String
  isRead    Boolean  @default(false)
  relatedId String?
  createdAt DateTime @default(now())
}

// relationType: "SUPERIOR" | "PEER" | "SUBORDINATE"
model UserRelation {
  id            String   @id @default(cuid())
  managerId     String
  subordinateId String
  relationType  String   @default("SUBORDINATE")
  manager       User     @relation("manages", fields: [managerId], references: [id], onDelete: Cascade)
  subordinate   User     @relation("subordinateTo", fields: [subordinateId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([managerId, subordinateId])
}

// recurringType: "DAILY" | "WEEKLY" | "MONTHLY" | "YEARLY"
// recurringDay: 1-31 for MONTHLY, 0-6 for WEEKLY (0=Mon)
model Task {
  id                      String            @id @default(cuid())
  title                   String
  description             String?
  status                  String            @default("TODO")
  priority                String            @default("MEDIUM")
  assignedTo              User?             @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedToId            String?
  reviewOwnerId           String? // inceleme sahibi (varsayılan: createdById)
  assignmentLevelSnapshot Int? // atama anındaki atayan kıdem seviyesi
  departmentId            String? // proje dışı görevler için departman (user dept formatı)
  deletedAt               DateTime? // yumuşak silme
  reopenReason            String? // DONE→TODO geçişinde zorunlu sebep
  dueDate                 DateTime?
  createdBy               User              @relation("CreatedBy", fields: [createdById], references: [id])
  createdById             String
  parentTaskId            String?
  parent                  Task?             @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  children                Task[]            @relation("TaskHierarchy")
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  completedAt             DateTime?
  isRecurring             Boolean           @default(false)
  recurringType           String?
  recurringDay            Int?
  nextOccurrence          DateTime?
  recurringSeriesId       String?
  recurringSeries         RecurringSeries?  @relation("SeriesTasks", fields: [recurringSeriesId], references: [id], onDelete: SetNull)
  companyId               String?
  company                 Company?          @relation(fields: [companyId], references: [id])
  projectId               String?
  project                 Project?          @relation(fields: [projectId], references: [id])
  assignees               TaskAssignee[]
  feedbacks               Feedback[]
  files                   File[]
  logs                    TaskLog[]
  comments                TaskComment[]
  reviewRounds            TaskReviewRound[]
  sources                 TaskSource[]
  attachments             TaskAttachment[]
}

// endType: "INDEFINITE" | "SPECIFIC_DATE"
// recurringType: "DAILY" | "WEEKLY" | "MONTHLY" | "YEARLY"
// recurringDay: 0-6 for WEEKLY (0=Mon), 1-31 for MONTHLY
model RecurringSeries {
  id               String    @id @default(cuid())
  recurringType    String
  recurringDay     Int?
  startDate        DateTime
  endType          String    @default("INDEFINITE")
  endDate          DateTime?
  isStopped        Boolean   @default(false)
  nextOccurrenceAt DateTime
  title            String
  description      String?
  priority         String    @default("MEDIUM")
  assignedToId     String
  projectId        String?
  departmentId     String?
  ownerId          String
  createdAt        DateTime  @default(now())
  owner            User      @relation("SeriesOwner", fields: [ownerId], references: [id])
  assignedTo       User      @relation("SeriesAssignee", fields: [assignedToId], references: [id])
  tasks            Task[]    @relation("SeriesTasks")
}

// reviewAction: "APPROVED" | "REVISION_REQUESTED"
model TaskReviewRound {
  id             String           @id @default(cuid())
  task           Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId         String
  roundNumber    Int
  submittedBy    User             @relation("ReviewRoundSubmitter", fields: [submittedById], references: [id])
  submittedById  String
  submissionNote String
  submittedAt    DateTime         @default(now())
  reviewedBy     User?            @relation("ReviewRoundReviewer", fields: [reviewedById], references: [id])
  reviewedById   String?
  reviewAction   String?
  reviewNote     String?
  reviewedAt     DateTime?
  attachments    TaskAttachment[]
}

// type: "LINK" | "FILE"
model TaskSource {
  id          String   @id @default(cuid())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String
  type        String
  name        String
  url         String?
  storageKey  String?
  description String?
  addedBy     User     @relation(fields: [addedById], references: [id])
  addedById   String
  createdAt   DateTime @default(now())
}

// kind: "SUBMISSION" | "FEEDBACK"
// type: "LINK" | "FILE"
model TaskAttachment {
  id             String           @id @default(cuid())
  task           Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId         String
  reviewRound    TaskReviewRound? @relation(fields: [reviewRoundId], references: [id], onDelete: SetNull)
  reviewRoundId  String?
  kind           String
  type           String
  name           String
  url            String?
  storageKey     String?
  size           Int?
  uploadedBy     User             @relation(fields: [uploadedById], references: [id])
  uploadedById   String
  createdAt      DateTime         @default(now())
  retentionUntil DateTime?
  purgedAt       DateTime?
}

model TaskAssignee {
  id     String @id @default(cuid())
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([taskId, userId])
}

model TaskTemplate {
  id            String   @id @default(cuid())
  title         String
  description   String?
  priority      String   @default("MEDIUM")
  estimatedDays Int?
  department    String?
  createdBy     User     @relation("TemplateCreator", fields: [createdById], references: [id])
  createdById   String
  createdAt     DateTime @default(now())
}

model TaskComment {
  id        String   @id @default(cuid())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  content   String
  createdAt DateTime @default(now())
}

model LoginLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  ip        String?
  userAgent String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model TaskLog {
  id              String    @id @default(cuid())
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId          String
  user            User      @relation(fields: [userId], references: [id])
  userId          String
  action          String // STARTED | COMPLETED | STATUS_CHANGED | MANUAL_TIME | REASSIGNED | PROJECT_CHANGED
  fromStatus      String?
  toStatus        String?
  // Genel amaçlı önce/sonra metin anlık görüntüsü (ör. REASSIGNED: eski/yeni atanan adı,
  // PROJECT_CHANGED: eski/yeni proje adı). fromStatus/toStatus yalnızca Task.status
  // değerleri için kullanılır; bunlar isim/başlık gibi serbest metin değerler içindir.
  fromValue       String?
  toValue         String?
  timestamp       DateTime  @default(now())
  durationMinutes Int?
  startedAt       DateTime?
  completedAt     DateTime?
  manualEntry     Boolean   @default(false)
}

model Feedback {
  id         String   @id @default(cuid())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     String
  fromUser   User     @relation(fields: [fromUserId], references: [id])
  fromUserId String
  message    String
  createdAt  DateTime @default(now())
}

model File {
  id             String    @id @default(cuid())
  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId         String
  uploadedBy     User      @relation(fields: [uploadedById], references: [id])
  uploadedById   String
  filename       String
  path           String
  comment        String?
  createdAt      DateTime  @default(now())
  retentionUntil DateTime? // completedAt + 1 yıl; görev aktifken null
  purgedAt       DateTime? // fiziksel silme tarihi; meta veri korunur
}

// category: "SUGGESTION" | "COMPLAINT" | "PETITION"
model Petition {
  id          String   @id @default(cuid())
  user        User?    @relation(fields: [userId], references: [id])
  userId      String?
  category    String // SUGGESTION | COMPLAINT | PETITION
  message     String
  isAnonymous Boolean  @default(false)
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// type: "ANNUAL" | "EXCUSE" | "UNPAID"
// status: "PENDING" | "APPROVED" | "REJECTED"
model LeaveRequest {
  id         String   @id @default(cuid())
  user       User     @relation("LeaveRequests", fields: [userId], references: [id])
  userId     String
  startDate  DateTime
  endDate    DateTime
  days       Int
  type       String // ANNUAL | EXCUSE | UNPAID
  note       String?
  status     String   @default("PENDING")
  reviewedBy String?
  createdAt  DateTime @default(now())
}

model LeaveBalance {
  id            String @id @default(cuid())
  user          User   @relation("LeaveBalances", fields: [userId], references: [id])
  userId        String
  year          Int
  totalDays     Int    @default(14)
  usedDays      Int    @default(0)
  remainingDays Int    @default(14)

  @@unique([userId, year])
}

// date: "YYYY-MM-DD" | time: "HH:MM" | duration in minutes
// department: hangi departman davet edildi
model Meeting {
  id          String            @id @default(cuid())
  title       String
  description String?
  date        String // YYYY-MM-DD
  time        String // HH:MM
  duration    Int // 30 | 60 | 120
  department  String
  createdBy   User              @relation("MeetingCreator", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime          @default(now())
  attendees   MeetingAttendee[]
}

// status: "PENDING" | "ACCEPTED" | "DECLINED"
model MeetingAttendee {
  id        String  @id @default(cuid())
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  status    String  @default("PENDING")

  @@unique([meetingId, userId])
}

model Company {
  id          String              @id @default(cuid())
  name        String
  taxNumber   String?
  sector      String?
  startDate   DateTime?
  notes       String?
  about       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  assignments CompanyAssignment[]
  tasks       Task[]
}

// department: "OUTSOURCE" | "BAGIMSIZ_DENETIM" | "MUHASEBE" | "YMM"
// status: "ACTIVE" | "DONE" | "ARCHIVED" | "DELETED"
model Project {
  id          String          @id @default(cuid())
  name        String
  department  String // "OUTSOURCE" | "BAGIMSIZ_DENETIM" | "MUHASEBE" | "YMM"
  status      String          @default("ACTIVE") // "ACTIVE" | "DONE" | "ARCHIVED" | "DELETED"
  deletedAt   DateTime?
  taxNumber   String?
  sector      String?
  startDate   DateTime?
  endDate     DateTime?
  notes       String?
  about       String?
  createdById String
  createdBy   User            @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     ProjectMember[]
  tasks       Task[]
}

model ProjectMember {
  id         String   @id @default(cuid())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  assignedAt DateTime @default(now())
  assignedBy String   @default("")

  @@unique([projectId, userId])
}

model CompanyAssignment {
  id         String   @id @default(cuid())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  assignedAt DateTime @default(now())
  assignedBy String // userId of assigner

  @@unique([companyId, userId])
}

model KdvIadeKayit {
  id           String   @id @default(cuid())
  tur          String // "indirilecek" | "yuklenilen" | "satis"
  faturaSayisi Int
  toplamKdv    Float
  haricTutulan Int      @default(0)
  createdAt    DateTime @default(now())
}

// module: "BEYANNAME" | "TXT_EXCEL" | "KARSILASTIRMA" | "TARAYICI"
model AiPrompt {
  id        String   @id @default(cuid())
  module    String   @unique
  prompt    String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// durum: "HAZIRLANDI" | "DIJITAL_VD_GIRILDI" | "MUKELLEF_CEVAPLADI" | "ONAYLANDI" | "PASIF_TALEP"
model KarsitInceleme {
  id             String    @id @default(cuid())
  mukellefUnvan  String
  mukellefVkn    String
  mukellefVD     String
  konu           String // "KDV_IADE" | "TAM_TASDIK"
  donemBas       String // "YYYY/MM"
  donemBit       String // "YYYY/MM"
  durum          String    @default("HAZIRLANDI")
  gonderimTarihi DateTime?
  ymmAdi         String    @default("")
  ymmSicilNo     String    @default("")
  ymmVergiNo     String    @default("")
  faturalar      String    @default("[]") // JSON array of KarsitFatura
  notlar         String    @default("")
  olusturanId    String
  olusturan      User      @relation(fields: [olusturanId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ── ROTASYON TAKİP MODÜLÜ ─────────────────────────────────────────────────────
// Denetçi rotasyonu takibi: işletme başına sözleşme dönemleri ve kadro (asıl/yedek).
// Erişim: User.canAccessRotasyon (bkz. lib/access.ts canAccessRotasyon) — kıdem/
// departman/e-postadan ASLA türetilmez.
//
// tur (RotasyonSozlesme): "TTK_ZORUNLU" | "SPK_ZORUNLU" | "IHTIYARI_TFRS" | "GUVENCE" | "SURDURULEBILIRLIK"
// tip (RotasyonKadro)   : "ASIL" | "YEDEK"

model RotasyonIsletme {
  id                    String             @id @default(cuid())
  unvan                 String
  vkn                   String             @unique
  oncekiDenetciIlkDonem Int?
  oncekiDenetciSonDonem Int?
  not                   String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  deletedAt             DateTime? // yumuşak silme
  sozlesmeler           RotasyonSozlesme[]
}

model RotasyonSozlesme {
  id         String          @id @default(cuid())
  isletme    RotasyonIsletme @relation(fields: [isletmeId], references: [id])
  isletmeId  String
  sozlesmeNo String
  donem      Int // tek hesap dönemi (yıl)
  tur        String // RotasyonSozlesmeTuru
  not        String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  kadrolar   RotasyonKadro[]

  @@unique([isletmeId, donem, tur]) // aynı işletme + aynı dönem + aynı TÜR için mükerrer sözleşme koruması —
  // aynı dönemde farklı türde birden fazla sözleşme (ör. bağımsız denetim + özel amaçlı denetim) olabilir
}

model RotasyonKadro {
  id              String           @id @default(cuid())
  sozlesme        RotasyonSozlesme @relation(fields: [sozlesmeId], references: [id], onDelete: Cascade)
  sozlesmeId      String
  adSoyad         String
  unvan           String
  tip             String // "ASIL" | "YEDEK"
  fiilenGorevAldi Boolean          @default(true)
}

// Tek satırlık genel ayar tablosu — id sabit "singleton" değeriyle upsert edilir.
model RotasyonAyar {
  id         String @id @default("singleton")
  cariDonem  Int    @default(2026) // cari hesap dönemi — ARA/DOLDU ayrımı ve "yıl planı" bu yıla göre hesaplanır
  azamiSure  Int    @default(7)
  zorunluAra Int    @default(3)
  uyariEsigi Int    @default(3)
}
